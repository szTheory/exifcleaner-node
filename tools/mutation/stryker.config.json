{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": [
    "@stryker-mutator/*",
    "./tools/mutation/ignorers/error-message.mjs"
  ],
  "ignorers": ["error-message"],
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tools/mutation/tsconfig.stryker.json",
  "vitest": {
    "configFile": "tools/mutation/vitest.stryker.config.ts",
    "pool": "forks",
    "related": true
  },
  "mutate": ["src/**/*.ts"],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 15000,
  "timeoutFactor": 2.5,
  "ignoreStatic": true,
  "incremental": false,
  "reporters": ["json", "html", "clear-text", "event-recorder"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "eventReporter": { "baseDir": "reports/mutation/events" },
  "thresholds": { "high": 90, "low": 80, "break": null },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "ignorePatterns": [
    "coverage",
    ".vitest",
    "dist",
    "reports",
    "tools/mutation/node_modules",
    "stryker.log"
  ]
}
