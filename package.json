{
  "name": "exifcleaner-node",
  "version": "0.1.1",
  "description": "A small, typed metadata inspection and sanitization engine for Node.js",
  "type": "module",
  "gypfile": false,
  "license": "MIT",
  "author": {
    "name": "szTheory",
    "url": "https://exifcleaner.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szTheory/exifcleaner-node.git"
  },
  "bugs": {
    "url": "https://github.com/szTheory/exifcleaner-node/issues"
  },
  "homepage": "https://github.com/szTheory/exifcleaner-node#readme",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "prebuilds/linux-x64/publication.node",
    "prebuilds/linux-arm64/publication.node",
    "prebuilds/darwin-x64/publication.node",
    "prebuilds/darwin-arm64/publication.node",
    "prebuilds/win32-x64/publication.node",
    "prebuilds/win32-arm64/publication.node",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:native": "node scripts/build_native.cjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "vitest run",
    "qualify": "node scripts/qualification/qualify.cjs",
    "benchmark:qualify": "node scripts/qualification/benchmark.cjs",
    "test:watch": "vitest",
    "check:cycles": "madge --circular --extensions ts src/index.ts",
    "check:dist": "git diff --exit-code -- dist",
    "check:runtime": "node scripts/runtime_surface_gate.mjs .",
    "check:release": "node scripts/release_workflow_gate.cjs .github/workflows/release.yml",
    "check:pack": "npm pack --dry-run",
    "verify": "npm run lint && npm run typecheck && npm test && npm run check:cycles && npm run build && npm run check:runtime && npm run check:dist && npm run check:pack"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "fast-check": "4.9.0",
    "madge": "8.0.0",
    "node-gyp": "13.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
